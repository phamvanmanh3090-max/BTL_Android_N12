<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".activity.ConsultationActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consultation Screen"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableTop="@drawable/ic_home"
            android:drawableTint="@color/bottom_nav_item_color"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Trang chủ"
            android:textColor="@color/bottom_nav_item_color"
            app:layout_constraintEnd_toStartOf="@+id/navAlarm"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/navAlarm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableTop="@drawable/ic_alarm"
            android:drawableTint="@color/bottom_nav_item_color"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Lịch trình"
            android:textColor="@color/bottom_nav_item_color"
            app:layout_constraintEnd_toStartOf="@+id/navStore"
            app:layout_constraintStart_toEndOf="@+id/navHome"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/navStore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableTop="@drawable/ic_store"
            android:drawableTint="@color/bottom_nav_item_color"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Cửa hàng"
            android:textColor="@color/bottom_nav_item_color"
            app:layout_constraintEnd_toStartOf="@+id/navConsultation"
            app:layout_constraintStart_toEndOf="@+id/navAlarm"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/navConsultation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableTop="@drawable/ic_consultation"
            android:drawableTint="@color/bottom_nav_item_color"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Tư vấn"
            android:textColor="@color/bottom_nav_item_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navStore"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>