<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vầng sáng lan tỏa bên ngoài -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#6665B8B2"
                android:endColor="#0065B8B2"
                android:gradientRadius="65dp"
                android:startColor="#9965B8B2"
                android:type="radial" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <!-- Quả cầu thủy tinh bên trong -->
    <item
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="#76C8C1"
                android:endColor="#214E52"
                android:startColor="#E0FAF8"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>