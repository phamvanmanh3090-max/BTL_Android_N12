<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/background" /></shape>
    </item>
    <item android:height="170dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/header_start"
                android:endColor="@color/header_end" android:type="linear" />
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp" />
        </shape>
    </item>
</layer-list>